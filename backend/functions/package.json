{
  "name": "thinkofme-functions",
  "private": true,
  "description": "Cloud Functions for ThinkOfMe",
  "type": "commonjs",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/unit",
    "test:rules": "cd .. && firebase emulators:exec --only firestore --project demo-thinkofme \"npm --prefix functions run vitest:rules\"",
    "vitest:rules": "vitest run test/rules",
    "serve": "npm run build && cd .. && firebase emulators:start --project demo-thinkofme",
    "deploy": "cd .. && firebase deploy --only functions,firestore,storage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "cheerio": "1.2.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "undici": "8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "22.20.5",
    "firebase": "13.2.0",
    "firebase-tools": "15.35.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
