// Shared settings. Real values for release live in Secrets.xcconfig (git-ignored).
// Google's public test app id; replace via Secrets.xcconfig for release builds.
GAD_APPLICATION_ID = ca-app-pub-3940256099942544~1458002511
// Google test ad units until real AdMob units are set (TestFlight shows "Test Ad").
TOM_NATIVE_AD_UNIT_ID = ca-app-pub-3940256099942544/3986624511
TOM_BANNER_AD_UNIT_ID = ca-app-pub-3940256099942544/2435281174
// From GoogleService-Info.plist (REVERSED_CLIENT_ID); enables Google sign-in.
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.placeholder
DEVELOPMENT_TEAM =
// Host of the Hosting site that serves invite links (https://<host>/i/<code>).
LINK_HOST = thinkofme.web.app
