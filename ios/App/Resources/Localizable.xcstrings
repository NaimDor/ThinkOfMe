            "value": "Я подарю это"
          }
        }
      }
    },
    "claim_hint_bought": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الشراء. سيرى الآخرون أنها محجوزة، أما %@ فلن يعرف أبدًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bought. Others see it's taken. %@ never will."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נקנה. האחרים יראו שזה תפוס. %@ לעולם לא."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Куплено. Остальные увидят, что подарок занят. %@ — никогда."
          }
        }
      }
    },
    "claim_hint_mine": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستشتري هذه. سيرى الآخرون أنها محجوزة، أما %@ فلن يعرف أبدًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're getting this. Others see it's taken. %@ never will."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתם קונים את זה. האחרים יראו שזה תפוס. %@ לעולם לא."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы дарите это. Остальные увидят, что подарок занят. %@ — никогда."
          }
        }
      }
    },
    "claim_hint_open": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مهما اخترت، سيبقى الأمر سرًّا عن %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whatever you choose stays hidden from %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה שתבחרו יישאר סוד מ%@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш выбор останется тайной для получателя (%@)."
          }
        }
      }
    },
    "claim_hint_other": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ سيشتري هذه. %2$@ لا يعلم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is getting this. %2$@ doesn't know."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ קונים את זה. %2$@ לא יודעים."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ дарит это. %2$@ не знает."
          }
        }
      }
    },
