    "clear_photo_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عبّأنا بعض التفاصيل من هذه الصورة. هل نمسحها أيضًا؟ ما غيّرته بنفسك سيبقى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We filled in some details from this photo. Clear them too? Anything you changed yourself stays."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מילאנו פרטים לפי התמונה הזו. לנקות גם אותם? מה ששינית בעצמך יישאר."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы заполнили некоторые поля по этому фото. Очистить их тоже? То, что вы изменили сами, останется."
          }
        }
      }
    },
