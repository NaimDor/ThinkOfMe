    "welcome_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قائمة أمنيات لمن يحبونك، ونظرة هادئة على ما يتمنونه هم أيضًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a wishlist for the people who love you, and quietly see what they'd love too."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשימת משאלות לאנשים שאוהבים אתכם, ומבט שקט על מה שהם היו שמחים לקבל."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список желаний для тех, кто вас любит, и тихий взгляд на то, о чём мечтают они."
          }
