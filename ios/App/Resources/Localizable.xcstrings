    "delete_account_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف أمنياتك وتواريخك وعضويتك في الدوائر نهائيًا. لا يمكن التراجع عنه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes your wishes, dates and circles membership. It can't be undone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעולה מוחקת לצמיתות את המשאלות, התאריכים והחברות במעגלים. אי אפשר לבטל אותה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши желания, даты и участие в кругах будут удалены навсегда. Это нельзя отменить."
          }
        }
      }
    },
