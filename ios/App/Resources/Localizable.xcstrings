    "circles_empty_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدائرة هي من يرى أمنياتك: شريكك، عائلتك، أصدقاؤك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A circle is who sees your wishes: your partner, your family, your friends."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעגל הוא מי שרואה את המשאלות שלך: בן או בת הזוג, המשפחה, החברים."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Круг — это те, кто видит ваши желания: партнёр, семья, друзья."
          }
        }
      }
    },
    "circles_empty_title": {
      "extractionState": "manual",
