    "tracking_reason": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لنا عرض إعلانات أكثر ملاءمة لك. يعمل ThinkOfMe بالطريقة نفسها في كل الأحوال."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets us show ads that are more relevant to you. ThinkOfMe works the same either way."
