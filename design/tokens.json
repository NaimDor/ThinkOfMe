{
  "$comment": "Single source of truth for ThinkOfMe design tokens. Run `node design/generate-tokens.mjs` after editing; it regenerates Swift + Kotlin and fails if text contrast drops below WCAG AA.",
  "color": {
    "light": {
      "canvas": "#FBF7F2",
      "surface": "#FFFFFF",
      "surfaceTint": "#FBE7E1",
      "surfaceMuted": "#F1EAE3",
      "ink": "#241628",
      "inkMuted": "#6F6272",
      "hairline": "#EDE5DD",
      "accent": "#C23A3F",
      "onAccent": "#FFFFFF",
      "accentText": "#B8343A",
      "accentTrack": "#F2CBC1",
      "ribbon": "#F2C46D",
      "ribbonDeep": "#C98E2F",
      "onRibbon": "#4A2E00",
      "positive": "#3E7A52",
      "danger": "#B3261E"
    },
    "dark": {
      "canvas": "#140B19",
      "surface": "#1E1225",
      "surfaceTint": "#22142B",
      "surfaceMuted": "#2A1A33",
      "ink": "#F5ECF2",
      "inkMuted": "#B6A6BB",
      "hairline": "#2C2032",
      "accent": "#F2C46D",
      "onAccent": "#2A1405",
      "accentText": "#F2C46D",
      "accentTrack": "#3A2A2E",
      "ribbon": "#F2C46D",
      "ribbonDeep": "#C98E2F",
      "onRibbon": "#2A1405",
      "positive": "#7FC196",
      "danger": "#F2B8B5"
    }
  },
  "personHues": ["#C94A45", "#4E8A62", "#3F64B5", "#7B55B0", "#2E7F7B", "#A86A12", "#B8467A", "#56677A"],
  "contrastChecks": [
    ["ink", "canvas"], ["ink", "surface"], ["ink", "surfaceTint"],
    ["inkMuted", "canvas"], ["inkMuted", "surface"],
    ["accentText", "canvas"], ["accentText", "surface"],
    ["onAccent", "accent"], ["onRibbon", "ribbon"]
  ],
  "type": {
    "displayLarge": { "size": 32, "lineHeight": 36, "weight": 600, "family": "display", "tracking": -0.5 },
    "displayMedium": { "size": 26, "lineHeight": 30, "weight": 600, "family": "display", "tracking": -0.3 },
    "title": { "size": 20, "lineHeight": 26, "weight": 600, "family": "display", "tracking": 0 },
    "headline": { "size": 17, "lineHeight": 22, "weight": 600, "family": "text", "tracking": 0 },
    "body": { "size": 16, "lineHeight": 22, "weight": 400, "family": "text", "tracking": 0 },
    "bodyStrong": { "size": 16, "lineHeight": 22, "weight": 600, "family": "text", "tracking": 0 },
    "callout": { "size": 14, "lineHeight": 20, "weight": 400, "family": "text", "tracking": 0 },
    "caption": { "size": 13, "lineHeight": 18, "weight": 400, "family": "text", "tracking": 0 },
    "overline": { "size": 12, "lineHeight": 16, "weight": 700, "family": "text", "tracking": 1.0 },
    "tab": { "size": 11, "lineHeight": 14, "weight": 500, "family": "text", "tracking": 0 }
  },
  "space": { "xxs": 4, "xs": 8, "s": 12, "m": 16, "l": 24, "xl": 32, "xxl": 48 },
  "radius": { "s": 12, "m": 18, "l": 28, "pill": 999 },
  "motion": {
    "quickMs": 150,
    "standardMs": 300,
    "emphasizedMs": 500,
    "springResponse": 0.42,
    "springDamping": 0.78,
    "bouncyResponse": 0.5,
    "bouncyDamping": 0.55
  },
  "fonts": {
    "latin": "fraunces_semibold",
    "hebrew": "frankruhllibre_bold",
    "cyrillic": "lora_semibold",
    "arabic": "notonaskharabic_semibold"
  }
}
